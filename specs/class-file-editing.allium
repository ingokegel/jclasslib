-- allium: 3
-- class-file-editing.allium
--
-- Distilled from the jclasslib codebase (modules/data writing support,
-- modules/browser editing UI, modules/idea tool window, modules/agent).

use "./class-file-core.allium" as core

--
-- Scope: Mutation and editing of class files.
-- Includes: scalar value edits, access flag and enum edits, linked constant
--           pool edits, structural constant pool growth, bytecode opcode
--           replacement and immediate operand edits, modification tracking,
--           save flows (file, jar entry, running VM, save-elsewhere) and
--           discard flows (close, reload).
-- Excludes:
--   - Reading/parsing class files and rendering the tree/detail UI
--   - Navigation history (navigation-history.allium)
--   - Workspace and classpath configuration (classpath-workspace.allium)
--   - JVM attach mechanics (how a VM connection is established)

-- Contracts ------------------------------------------------------------------

contract ClassFilePersistence {
    read: (bytes: ByteArray) -> core/ClassFile
    write: (class_file: core/ClassFile) -> ByteArray

    @invariant RoundTripFidelity
        -- Writing an unmodified class file reproduces the exact source
        -- bytes, including attributes the tool does not interpret.

    @invariant AppendOnlyConstantPool
        -- Constant pool growth appends entries at the end (a wide entry
        -- reserves a following placeholder slot). Indices of existing
        -- entries never change and entries are never removed.
}

contract BytecodePersistence {
    disassemble: (code: ByteArray) -> core/ClassFile
    assemble: (class_file: core/ClassFile) -> ByteArray

    @invariant BytecodeRoundTrip
        -- Assembling a disassembled method body reproduces the exact
        -- original bytes, including switch padding.
}

-- Rules ----------------------------------------------------------------------

rule EditScalarValue {
    when: EditValue(doc, entry, input)
    requires: doc.writable
    requires: entry.scalar_value != null
    requires: input != entry.scalar_value
    requires: valid_scalar(input, entry.constant_kind)     -- black box: input parses for the entry's kind
    ensures: entry.scalar_value = input
    ensures: doc.is_modified = true

    @guidance
        -- Covers both constant pool scalar payloads (UTF8 text, numeric
        -- constant values, signature/source file strings) and numeric
        -- structure fields (class file major/minor version). A long
        -- constant only accepts input in long range; a version field
        -- only accepts integers.
}

rule InvalidEditRejected {
    when: EditValue(doc, entry, input)
    requires: entry.scalar_value != null
    requires: not valid_scalar(input, entry.constant_kind)
    ensures: core/UserMessage.created(severity: error)
    -- The entry is unchanged and the class is not marked modified.

    @guidance
        -- Numeric structure fields (class file version numbers) are the
        -- exception: invalid input aborts the edit silently, without a
        -- message.
}

rule EditConstrainedValue {
    when: ChooseValue(doc, target, choice)
    requires: doc.writable
    requires: choice in allowed_choices(target)            -- black box: enum constants or context-valid access flags
    ensures: target.scalar_value = choice
    ensures: doc.is_modified = true

    @guidance
        -- Only valid choices are offered (checkboxes of the access flags
        -- legal in the given context, fixed lists of enum constants), so
        -- invalid selections cannot be made at all.
}

rule EditLinkedConstant {
    when: EditLinkedValue(doc, owner, target, input)
    -- Editing a referencing entry (e.g. a class reference) edits the
    -- scalar entry it points to (e.g. the class name UTF8).
    requires: doc.writable
    requires: target in owner.references
    requires: target.scalar_value != null
    requires: valid_scalar(input, target.constant_kind)
    ensures: target.scalar_value = input
    ensures: doc.is_modified = true
}

rule UnsupportedLinkedEditRejected {
    when: EditLinkedValue(doc, owner, target, input)
    requires: target.scalar_value = null
    ensures: core/UserMessage.created(severity: warning)
}

rule AddConstantPoolEntry {
    when: AddConstantPoolEntry(doc, kind, value, refs)
    requires: doc.writable
    let matches = filter(doc.class_file.constant_pool, e => same_entry_value(e, kind, value, refs))  -- black box: value equality
    ensures:
        if matches.count = 0:
            core/ConstantPoolEntry.created(
                constant_kind: kind,
                scalar_value: value,
                references: refs
            )
            if kind in {long, double}:
                core/ConstantPoolEntry.created(constant_kind: placeholder)
            doc.is_modified = true
        else:
            core/UserMessage.created(severity: info)

    @guidance
        -- An entry equal to an existing one is reused instead of added.
        -- New entries are appended; a wide entry (long, double) reserves
        -- a following placeholder slot. There is no removal of entries,
        -- so existing indices never change.
}

rule AddStructuralEntry {
    when: AddStructuralEntry(doc, kind, name)
    -- Structural edits such as adding a module exports/opens directive
    -- append the required constant pool entries (e.g. a package entry).
    requires: doc.writable
    ensures: AddConstantPoolEntry(doc, kind, name, [])
    ensures: doc.is_modified = true

    @guidance
        -- The displayed constant pool grows to show the appended entries.
}

rule ReplaceOpcode {
    when: ReplaceOpcode(doc, instruction, new_opcode)
    requires: doc.writable
    requires: new_opcode != instruction.opcode
    requires: new_opcode.structural_class = instruction.opcode.structural_class
    requires: new_opcode.stack_effect = instruction.opcode.stack_effect
    ensures: instruction.opcode = new_opcode
    ensures: doc.is_modified = true

    @guidance
        -- Immediate operands carry over unchanged. Only same-length,
        -- stack-compatible replacements are offered. Branch offsets, the
        -- exception table, stack maps and max_stack/max_locals are NOT
        -- recomputed: the user can intentionally produce an inconsistent
        -- class file.
}

rule IncompatibleOpcodeRejected {
    when: ReplaceOpcode(doc, instruction, new_opcode)
    requires: not (new_opcode.structural_class = instruction.opcode.structural_class
        and new_opcode.stack_effect = instruction.opcode.stack_effect)
    ensures: core/UserMessage.created(severity: warning)
}

rule EditImmediateOperand {
    when: EditImmediate(doc, instruction, position, input)
    requires: doc.writable
    requires: valid_immediate(input, instruction)          -- black box: parses and fits the operand width
    ensures: instruction.immediates = with_immediate(instruction.immediates, position, input)  -- black box
    ensures: doc.is_modified = true
}

rule InvalidImmediateRejected {
    when: EditImmediate(doc, instruction, position, input)
    requires: not valid_immediate(input, instruction)
    ensures: core/UserMessage.created(severity: warning)
}

rule SaveToFile {
    when: SaveConfirmed(doc)
    requires: doc.is_modified
    requires: doc.can_save_in_place
    requires: doc.origin in {plain_file, jar_entry}
    ensures: doc.is_modified = false
    ensures: ClassPersisted(doc, overwrite)

    @guidance
        -- A jar entry is updated inside its archive; a plain file is
        -- overwritten in place.
}

rule SaveToRunningVm {
    when: SaveConfirmed(doc)
    requires: doc.is_modified
    requires: doc.origin = running_vm
    requires: doc.writable
    ensures: doc.is_modified = false
    ensures: ClassRedefined(doc)

    @guidance
        -- The running JVM may reject the redefinition (for example when
        -- the schema changed: fields or methods added or removed). The
        -- tool itself does not check redefinition compatibility.
}

rule VmRedefinitionRejected {
    when: RedefinitionRejected(doc, reason)                -- external stimulus from the JVM
    requires: doc.origin = running_vm
    ensures: doc.is_modified = true
    ensures: core/UserMessage.created(severity: error, text: reason)
}

rule SaveElsewhere {
    when: SaveToDirectory(doc, directory)
    requires: doc.is_modified
    ensures: ClassPersisted(doc, directory)
    ensures: doc.is_modified = false

    @guidance
        -- Always available, including for JDK module classes that cannot
        -- be written in place. The class is written into a package
        -- directory tree below the chosen directory.
}

rule SaveAllModifiedClasses {
    when: SaveAllRequested()
    for doc in core/OpenClasses where is_modified:
        ensures: SaveConfirmed(doc)

    @guidance
        -- Classes that cannot be written in place prompt for a target
        -- directory instead.
}

rule SaveAllCopiesToDirectory {
    when: SaveAllCopiesToDirectory(directory)
    for doc in core/OpenClasses:
        ensures: ClassPersisted(doc, directory)
    -- The classes stay modified: copies were written, the origins are
    -- unchanged.

    @guidance
        -- "Save open classes" writes all open classes, modified or not,
        -- into a package directory tree below the chosen directory and
        -- reports how many were saved.
}

rule CloseClass {
    when: CloseRequested(doc, discard_confirmed)
    requires: doc.is_modified implies discard_confirmed
    ensures: not exists doc

    @guidance
        -- Closing a modified class asks the user to confirm discarding
        -- the edits; cancelling keeps the class open. The tab title shows
        -- a modification marker while edits are unsaved.
}

rule ReloadClass {
    when: ReloadRequested(doc, discard_confirmed)
    requires: doc.is_modified implies discard_confirmed
    ensures: doc.class_file = read_from_origin(doc)        -- black box: fresh bytes from the origin
    ensures: doc.is_modified = false

    @guidance
        -- Reloading discards all unsaved edits after confirmation.
}

-- Invariants -----------------------------------------------------------------

invariant WideEntryReservesPlaceholder {
    for cf in core/ClassFiles:
        for w in cf.constant_pool where is_wide:
            cf.constant_pool.any(e => e.is_placeholder and e.index = w.index + 1)
}

invariant PlaceholderFollowsWideEntry {
    -- Index 0 of every constant pool is a placeholder by definition.
    for cf in core/ClassFiles:
        for p in cf.constant_pool where is_placeholder:
            p.index = 0 or cf.constant_pool.any(e => e.is_wide and e.index = p.index - 1)
}

invariant JdkModulesNotWritableInPlace {
    for doc in core/OpenClasses:
        doc.origin = jdk_module implies not doc.can_save_in_place
}

-- Surfaces -------------------------------------------------------------------

surface ClassFileDetailEditor {
    facing user: core/User
    context doc: core/OpenClass

    exposes:
        doc.class_file.constant_pool
        doc.class_file.methods
        doc.is_modified
        doc.can_save_in_place

    provides:
        EditValue(user, doc, entry, input) when doc.writable
        ChooseValue(user, doc, target, choice) when doc.writable
        EditLinkedValue(user, doc, owner, target, input) when doc.writable
        AddStructuralEntry(user, doc, kind, name) when doc.writable

    contracts:
        fulfils ClassFilePersistence

    @guarantee NoSilentFailures
        -- Every attempted edit ends in exactly one of: the value changes
        -- and the class is marked modified, a message explains why the
        -- edit was rejected, or nothing happens because the value was
        -- unchanged.

    related:
        ByteCodeEditor(doc)
        ClassFileSave(doc) when doc.is_modified
}

surface ByteCodeEditor {
    facing user: core/User
    context doc: core/OpenClass

    exposes:
        for method in doc.class_file.methods:
            method.code
            method.max_stack
            method.max_locals
        -- Invalid branch targets (offsets outside the method body) are
        -- flagged in the display.

    provides:
        ReplaceOpcode(user, doc, instruction, opcode) when doc.writable
        EditImmediate(user, doc, instruction, position, input) when doc.writable

    contracts:
        fulfils BytecodePersistence

    @guarantee CompatibleReplacementsOnly
        -- Only opcodes with the same structural class and the same stack
        -- effect can replace an instruction; operands carry over. There
        -- is no insertion or deletion of instructions.
}

surface ClassFileSave {
    facing user: core/User
    context doc: core/OpenClass where is_modified

    provides:
        SaveConfirmed(user, doc) when doc.can_save_in_place
        SaveToDirectory(user, doc, directory)
        SaveAllRequested(user)
        SaveAllCopiesToDirectory(user, directory)
        CloseRequested(user, doc, discard_confirmed)
        ReloadRequested(user, doc, discard_confirmed)

    contracts:
        fulfils ClassFilePersistence

    @guarantee GuardedOverwrite
        -- Overwriting in place always asks first (overwrite, choose a
        -- directory, or cancel); the choice can be remembered for the
        -- session. JDK module classes can only be saved to a directory.
        -- A class stays modified until an in-place save succeeds; saving
        -- a copy to a directory does not clear the modification state.

    @guidance
        -- Edit affordances are hidden entirely when the class file is
        -- not writable (for example IDE classes without a writable URL).
}

-- Open questions -------------------------------------------------------------

open question "Edits have no undo/redo (history covers navigation only) - feature candidate"

-- Accepted as intended behaviour:
-- - Saving to a running VM does not pre-check JVM redefinition restrictions;
--   the JVM's rejection is surfaced as an error and the class stays modified
--   (see SaveToRunningVm, VmRedefinitionRejected).
-- - Bytecode edits do not recompute branch offsets, exception tables, stack
--   maps or max stack/locals. Opcode replacement is restricted to same-length,
--   stack-compatible opcodes, which keeps this metadata consistent; raw
--   immediate edits are a deliberate power tool (see ReplaceOpcode).
